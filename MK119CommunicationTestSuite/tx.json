{
	"tx_id":"modbus-tcp-fc3",
	"fields":[
		{
			"field_id":"transaction_id",
			"field_type":"REF",
			"data_type":"UI16AB",
			"value":"${transaction_id}"
		},
		{
			"field_id":"protocol_id",
			"field_type":"STATIC",
			"data_type":"UI16AB",
			"value":"0"
		},
		{
			"field_id":"tcp_length",
			"field_type":"REF",
			"data_type":"UI16AB",
			"value":"${register_count}*2+3"
		},
		{
			"field_id":"unit_id",
			"field_type":"REF",
			"data_type":"UI8",
			"value":"${unit_id}"
		},
		{
			"field_id":"function_code",
			"field_type":"REF",
			"data_type":"UI8",
			"value":"${function_code}"
		},
		{
			"field_id":"length",
			"field_type":"REF",
			"data_type":"UI8",
			"value":"${register_count}*2"
		},
		{
			"field_id":"payload",
			"field_type":"ITERATION",
			"data_type":"SI16AB",
			"value":"rand(100)",
			"iteration_count":"${register_count}"
		}
	]
}