{
    "version": "0.2.0",
    "configurations": [
        {
            // F5 의 기본값(목록의 첫 설정).
            //   F5            preLaunchTask 가 앱을 띄우고(이미 떠 있으면 그대로) 여기에 붙는다
            //   Stop Debugging  앱까지 내려간다
            //
            // preLaunchTask 는 반드시 '끝나는' 태스크여야 한다. 예전에는 app-up(= app-console
            // + app-start 복합)을 썼는데, app-console 은 tail -F 라 끝나지 않는 background
            // 태스크다. 그러면 VS Code 가 preLaunch 단계에서 계속 기다려 디버거가 실제로
            // 붙지 않고(5005 에 연결이 생기지 않는다), 세션이 제대로 시작되지 않았으니
            // Stop Debugging 을 눌러도 postDebugTask 가 돌지 않아 앱이 그대로 남았다.
            // 그래서 app-start 만 건다. 콘솔 터미널은 folderOpen 으로 따로 뜬다.
            //
            // 앱 종료는 두 겹이다:
            //   1) postDebugTask — 정상 경로. 단 '사용자가 멈췄을 때' 와 '대상 JVM 이 사라져
            //      끊겼을 때' 를 구분하지 못해, app.sh 쪽에서 재시작 중이면 건너뛴다.
            //   2) app.sh 의 watchdog — VS Code 가 postDebugTask 를 아예 주지 않는 경우까지
            //      대비해, 붙어 있던 디버거가 떨어지면 앱과 콘솔을 내린다 (app.sh 주석 참고).
            "type": "java",
            "name": "Attach (MK119, port 5005)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "projectName": "MK119CommunicationTestSuite",
            "preLaunchTask": "app-start",
            "postDebugTask": "app-stop-on-debug-exit"
        },
        {
            // 예전 방식: VS Code 가 JVM 을 직접 띄운다. 디버그 세션을 멈추면 앱도 죽고,
            // VS Code 밖에서는 재시작할 수 없다. 위 Attach 로 대체되었지만 남겨 둔다.
            "type": "java",
            "name": "Spring Boot (MK119) — VS Code 가 직접 실행",
            "request": "launch",
            "mainClass": "com.onionsoftware.mk119.commtestsuite.Mk119CommunicationTestSuiteApplication",
            "projectName": "MK119CommunicationTestSuite",
            // application.properties 는 jar 밖(모듈 디렉터리)에 있다.
            // Spring Boot 는 작업 디렉터리의 ./application.properties 를 읽으므로
            // cwd 를 모듈로 맞추지 않으면 DataSource 설정을 찾지 못한다.
            "cwd": "${workspaceFolder}/MK119CommunicationTestSuite",
            "console": "integratedTerminal",
            "preLaunchTask": "kill-port-8082",
            "postDebugTask": "kill-port-8082"
        }
    ]
}
